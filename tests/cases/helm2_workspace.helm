workspace {
    globals {
        OBJ_DIR = OBJ_DIR
        LIB_DIR = LIB_DIR
    }
}

adapter c_shared_library(SOURCE_FILES, OUT_NAME) {
    matrix SRC in SOURCE_FILES

    outputs = [ "${OBJ_DIR}/${OUT_NAME}_obj/${SRC}.o" ]

    run [
        "tools/scripts/compile_object.sh",
        "${SRC}",
        "${OBJ_DIR}/${OUT_NAME}_obj/${SRC}.o",
        "${OBJ_DIR}/${OUT_NAME}_obj/${SRC}.d",
        param LIBRARY_COMPILER_FLAGS,
        param CPPFLAGS,
    ]

    outputs = [ "${LIB_DIR}/lib${OUT_NAME}.so" ]

    run [
        "tools/scripts/link_objects.sh",
        "${LIB_DIR}/lib${OUT_NAME}.so",
        param MATRIX_OUTPUTS,
    ]
}

OBJ_DIR = "build/obj"
LIB_DIR = "build/lib"
LIBRARY_COMPILER_FLAGS = "-g"

entity sample {
    kind = "lib"
    use c_shared_library {
        params {
            SOURCE_FILES = [ "src/sample.c" ]
            OUT_NAME = "sample"
        }
    }
    interface {
        CPPFLAGS = [ "-Isrc" ]
    }
}

target smoke() {
    help = "workspace smoke target"
    depends_on [ "//sample:sample" ]
    run "true"
}
