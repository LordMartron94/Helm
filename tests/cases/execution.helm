GLOBAL_ENV = "production"

target base() {
    help = "Base node"
    artifacts { volatile = true }
    run "echo cmd_base"
}

target params_target(USER) {
    help = "Tests interpolation"
    artifacts { volatile = true }
    depends_on [ base ]
    
    run "echo cmd_params ${USER} ${GLOBAL_ENV}"
}

target conditions_target(MODE) {
    help = "Tests when blocks"
    artifacts { volatile = true }
    
    when defined(MODE) {
        run "echo cmd_mode_active ${MODE}"
    }
    
    when equals(MODE, "skip") {
        run "echo cmd_should_never_run"
    }
}

target failing_node() {
    help = "A node designed to fail"
    artifacts { volatile = true }
    run "echo cmd_fail"
}

target blocked_node() {
    help = "Should not execute because dependency fails"
    artifacts { volatile = true }
    depends_on [ failing_node ]
    run "echo cmd_blocked"
}

target optional_recovery_node() {
    help = "Should execute even if dependency fails"
    artifacts { volatile = true }
    depends_on [ 
        failing_node { optional = true } 
    ]
    run "echo cmd_recovery"
}

target confirm_node() {
    help = "Requires user confirmation"
    artifacts { volatile = true }
    depends_on [ 
        base { confirm = true } 
    ]
    run "echo cmd_confirmed"
}