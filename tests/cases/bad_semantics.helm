// ERROR 1: Duplicate global variable declaration
VERSION = "1.0.0"
VERSION = "1.0.1"

target build() {
    help = "Builds the application"
    artifacts { volatile = true }

    depends_on [
        missing_target      // ERROR 2: Undefined dependency
        valid_future_target // NO ERROR: Tests multi-pass graph resolution
    ]
    
    // ERROR 3: Interpolating a variable that was never declared
    run "echo ${UNDEFINED_VAR}"
}

// ERROR 4: Duplicate target definition
target build() {
    help = "Duplicate build"
    artifacts { volatile = true }

    run "echo duplicate"
}

target publish(TAG) {
    help = "Publishes the application"
    artifacts { volatile = true }

    // ERROR 5: Using an undeclared parameter in a condition
    when defined(UNKNOWN_PARAM) {
        // NO ERROR: TAG is a declared parameter. Your string interpolator 
        // MUST check local parameters, not just global variables.
        run "echo ${TAG}" 
    }
}

// Defined after reference to prove multi-pass works
target valid_future_target() {
    help = "I am defined late"
    artifacts { volatile = true }

    run "echo success"
}