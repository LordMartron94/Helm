SCAN_ROOT = "libs"

target scan() {
    help = "Validates glob extraction"
    artifacts {
        volatile = true
        inputs = [
            glob(SCAN_ROOT, include="**/*.go"),
            glob(".", exclude="*_test.go"),
            glob("vendor", follow_symlinks=true, recursive=false, types="directories")
        ]
    }

    run "echo ok"
}
